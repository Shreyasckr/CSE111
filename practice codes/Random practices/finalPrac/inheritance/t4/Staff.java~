public class Staff extends Employee{
    public int salary;
    
    public Staff(String s, int n, int m){
        super(s, n);
        salary = m;
    }
    public String details() {
        return "ID: " + id + " | Name: " + name+" | Type: Full-Time";
    }
    public int computeSalary(){
        return salary;
    }
}