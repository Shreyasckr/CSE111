import java.util.Scanner;
import java.util.Arrays;
public class ass1task3prev{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        double[] arr  = new arr[n];
        for(int i = 0;i<n;i++){
            arr[i] = sc.nextDouble(); 
        }
        int m = 0;
        for(int i = 0 ; i< n-1;i++){
            for(int j  = i+1; j<n; j++){
                if(arr[i]==arr[j]){
                    m++;
                }
            } 
        }
        double[] arr2  = new arr[n-m];
        for(int i  =0;i>n-m;i++){
            for(int i = 0 ; i< n-1;i++){
                for(int j  = i+1; j<n; j++){
                    if(arr[i]!=arr[j]){
                        arr2[i] = arr[i];
                    }
                } 
            }
        }
        System.out.println(Arrays.toString(arr2));
    }
}