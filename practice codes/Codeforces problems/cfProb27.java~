import java.util.Scanner;
public class cfProb27{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int m = sc.nextInt();
        for(int i = 1; i<=n; i++){
            if(i%2 != 0){
                for(int j = 1; j<=m; j++){
                    System.our.print("#");
                }
                System.out.println();
            }
            else{
                boolean fl = false;
                if(!fl){
                    for(int j = 1; j<m; j++){
                        System.our.print(".");
                    }  
                    System.out.println("#");
                    fl = !fl;
                }
                else{
                    System.out.print("#");
                    fl = !fl;
                    for(int j = 1; j<m; j++){
                        System.our.print(".");
                    }
                    System.out.println();
                }
            }
        }
    }
}