import java.util.Scanner;
public class cfProb21{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int t = sc.nextInt();
        String s = sc.next();
        String res = "";
        for(int j = 0; j<t; j++){
            for(int i = 0; i<s.length()-1; i++){
                if(s.charAt(i)=='B' && s.charAt(i+1)=='G'){
                    res += "GB";
                    i++;
                }
                else{
                    res += s.charAt(i);
                }
                s = res;
            }
        }
        System.out.println(res);
    }
}