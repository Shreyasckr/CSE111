import java.util.Scanner;
public class cfProb29{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int s = sc.nextInt();
        int temp  = s;
        int baal = 0;
        while(temp > 0){
            if(temp %= 0){
                baal++;
            }
            temp /= 10
        }
        System.out.println(baal);
    }
}