import java.util.Scanner;
public class cfprob36{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new Int[n];
        for(int i = 0; i<n; i++){
            arr[i] = sc.nextInt;
        }
        int temp;
        boolean swapped;
        for (int i = 0; i < n - 1; i++) {
            swapped = false;
            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                    swapped = true;
                }
            }
            if (swapped == false){
                break;
            }
        }
        int res = arr[(arr.length/2)+1];
        int x = 0;
        for(int i = 0; i<n; i++){
            if(arr[i] == res){
                x++;
            }
        }
        System.out.println((arr.length/2));
    }
}