import java.util.Scanner;
public class cfProb8{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        String res = "";
        char ch = s.charAt(0);
        if(ch>='a' && ch<='z'){
            res += (char)(ch+32);
        }
        for(int i = 1; i<s.length(); i++){
            res += s.charAt(i);
        }
    }
}