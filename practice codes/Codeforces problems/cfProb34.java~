import java.util.Scanner;
public class cfProb34{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        long a = sc.nextLong();
        long b = sc.nextLong();
        long c = sc.nextLong();
        long m = sc.nextLong();
        for(long i = 1; i<=m; i++){
            if(i%a==0 && i%b==0 && i%c==0){
                a += 2;
                b += 2;
                c += 2;
            }
            else if(i%a==0 && i%b==0){
                a += 3;
                b += 3;
            }
            else if(i%b==0 && i%c==0){
                c += 3;
                b += 3;
            }
            else if(i%c==0 && i%a==0){
                a += 3;
                c += 3;
            }
            else if(i%a==0){
                a += 6;
            }
            else if(i%b==0){
                b += 6;
            }
            else if(i%c==0){
                c += 6;
            }
        }
        System.out.println(a+" "+b+" "+c);
    }
}