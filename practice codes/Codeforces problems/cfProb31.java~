import java.util.Scanner;
public class cfProb31{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int px = 0;
        int py = 0;
        for(int i = 0; i<n; i++){
            int x = sc.nextInt();
            int y = sc.nextInt();
            if((x==px+2 || x==px+3 || x==px+4) && (y==py+1 || y==py || y==py-1)){
                System.out.println("YES");
                px = x;
                py = y;
            }
            else{
                System.out.println("NO");
            }
        }
    }
}